# Git
.git
.gitignore

# Build artifacts
bin/
*.exe
*.dll
*.so
*.dylib

# Test artifacts
*.test
*.out
coverage.*
*.coverprofile

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Dependencies
vendor/

# Environment
.env
.env.local

# Certificates (will be generated or mounted as volume)
certs/

# Documentation
*.md
!README.md
docs/

# CI/CD
.github/

# Node modules
**/node_modules/
# The binary embeds the committed playground/dist and the image does not
# rebuild it, so that directory is all of the playground the build needs.
playground/*
!playground/dist

# Magefiles
magefiles/

# Nomad
*.nomad

# Examples and demos
examples/
benchmarks/

# Go workspace
go.work
go.work.sum
