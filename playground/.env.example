# MoQ Relay Server URL (must be HTTPS for WebTransport)
VITE_RELAY_URL=https://localhost:4433

# Certificate SHA-256 hash for WebTransport (auto-generated by mage cert)
# VITE_CERT_HASH=

# Base URL of the HLS egress (`qumo hls`), for the HLS scenario. Unset, it is
# looked for on the page's host at port 8081, so start the egress with
# HLS_ADDR=:8081 and CORS_ALLOWED_ORIGINS set to the page's origin.
# VITE_HLS_URL=http://localhost:8081
